    <widget type="xyplot" version="3.0.0">
      <name>wf_plot</name>
      <x>10</x>
      <y>110</y>
      <width>930</width>
      <height>450</height>
      <show_toolbar>true</show_toolbar>
      <x_axis>
        <title>Time [s]</title>
        <autoscale>true</autoscale>
        <show_grid>true</show_grid>
      </x_axis>
      <y_axes>
        <y_axis>
          <title>Divisions</title>
          <minimum>-4.0</minimum>
          <maximum>4.0</maximum>
          <show_grid>true</show_grid>
        </y_axis>
      </y_axes>
      <traces>
        <trace>
          <name>CH1</name>
          <x_pv>pva://keysight0:tAxis</x_pv>
          <y_pv>pva://keysight0:c01Waveform</y_pv>
        </trace>
        <trace>
          <name>CH2</name>
          <x_pv>pva://keysight0:tAxis</x_pv>
          <y_pv>pva://keysight0:c02Waveform</y_pv>
        </trace>
        <trace>
